# ── HRBot Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Model Settings ────────────────────────────────────────────────────────────
# Options: "lightweight" | "conversational" | "qa_optimized"
DEFAULT_LLM=lightweight

# Optional Free API Keys for Sub-Second Ultra-Fast Acceleration:
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# ── Email Notifications (optional) ───────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Application ───────────────────────────────────────────────────────────────
# Set to "production" or "development"
APP_ENV=development
